NODE_SECRET=your_node_secret_here
NODE_ALIAS=ws-node-1
CONTROL_PLANE=https://cnct.accopture.top
# Bypassing Anti-VPN / Datacenter ASN blocks (No root / No apt needed!):
ENABLE_WARP=true

# Or use custom residential/SOCKS5 proxy:
# OUTBOUND_PROXY=socks5://127.0.0.1:1080

# Optional overrides:
# PORT=8080
# PUBLIC_IP=1.2.3.4
# KEEP_ALIVE=true
